# vercel
.vercel

# claude code agent state (local-only). The skills themselves live in
# agents/skills/ and are tracked there; .claude/skills only holds the symlinks
# Claude Code discovers them through, and those are tracked too. The directory
# has to be excluded by its contents rather than by itself: git will not
# re-include a path whose parent directory is excluded.
.claude/*
!.claude/skills/

# typescript
*.tsbuildinfo
next-env.d.ts

# local-only test/scratch pages (kept private, not deployed)
/app/test/

# editor
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
